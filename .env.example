# Copy this file to .env and fill in real values. Never commit .env with real secrets.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# OpenRouter API key (server-side only, never exposed to the browser). Used by the generic
# web-search fallback (lib/product/search-fallback/) when a supplier's direct product retrieval
# (e.g. Etsy) fails or returns too little to trust. Get a key from https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional: which OpenRouter model to use for the web-search fallback. Defaults to a
# tool-calling-and-JSON-capable model in code if unset — verify the current default is still
# live on OpenRouter's model roster before relying on it in production.
OPENROUTER_MODEL=

# Optional: whether to generate images for products. Defaults to false if unset.
SHOPFORGE_GENERATE_IMAGES=false

# Shopify app credentials (Partner Dashboard > Apps > your app > API credentials). Server-side
# only, never exposed to the browser. Powers the real "Connect your Shopify store" OAuth flow
# (app/api/shopify/install, app/api/shopify/callback).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Base HTTPS URL this app is reachable at, no trailing slash. Must exactly match an Allowed
# redirection URL registered on the Shopify app, with /api/shopify/callback appended — e.g. if
# this is "https://my-tunnel.trycloudflare.com", register
# "https://my-tunnel.trycloudflare.com/api/shopify/callback" on the app.
SHOPIFY_APP_URL=

# Space-separated OAuth scopes requested at install. Defaults to read_products if unset.
SHOPIFY_SCOPES=read_products

# Secret used to derive the AES-256-GCM key that encrypts stored Shopify access tokens at rest.
# Generate with: openssl rand -hex 32
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Optional: a Theme Access password (from Shopify's "Theme Access" app, installed on the target
# store), used only for Publish's theme-write calls. Real theme-write access normally requires
# Shopify's separate write_themes exemption on top of the OAuth scope, which can take weeks to be
# granted — a Theme Access password is Shopify's own documented way to test theme pushes before
# that exemption lands. Leave unset once the exemption is granted; the OAuth token is used then.
SHOPIFY_THEME_ACCESS_PASSWORD=