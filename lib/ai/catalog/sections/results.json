{
    "id": "results",
    "label": "Results",
    "purpose": "Display statistics and results with percentages",
    "category": "social-proof",
    "tags": [
        "stats"
    ],
    "allowed_on": [
        "index",
        "product",
        "page"
    ],
    "settings": {
        "results_headline": "inline_richtext",
        "title": "inline_richtext",
        "text": "richtext",
        "image": "image_picker",
        "video": "video",
        "style": [
            "circle",
            "number"
        ],
        "result_layout": [
            "horizontal",
            "vertical"
        ],
        "layout": [
            "results_first",
            "content_first"
        ],
        "enable_animations": [
            "true",
            "false"
        ],
        "animation_duration": {
            "type": "number",
            "min": 100,
            "max": 1000,
            "default": 500
        }
    },
    "allowed_blocks": [
        "row"
    ],
    "_notes": "'results_headline' is a short eyebrow/label rendered above 'title' (e.g. 'Results That Matter') — distinct from 'title', the section's own larger heading (e.g. 'The Numbers Don't Lie'). Write both; keep results_headline short (a few words), not a restatement of title."
}
