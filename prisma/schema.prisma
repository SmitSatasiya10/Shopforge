// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                    String   @id @default(uuid())
  sourceUrl             String
  sourcePlatform        String // "shopify" | "generic_html" | "sample" | "search_exact" | "search_related"
  importSource          String   @default("shopify") // which Start-screen entry point: "shopify" | "supplier" | "competitor" | "sample"
  supplierPlatform      String? // detected supplier platform for importSource="supplier": "amazon" | "etsy"
  importStatus          String // pending | importing | succeeded | partial | failed
  importError           String?
  importedFieldsMissing String[] @default([])

  title           String?
  description     String?
  price           Decimal? @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  currency        String?
  vendor          String?
  images          Json     @default("[]")
  variants        Json     @default("[]")
  options         Json     @default("[]")
  rawData         Json?
  personaOptionsJson Json? // cached AI persona options for the wizard: { language, options: [4 x PersonaOption] }
  marketingAnglesJson Json? // cached AI marketing angles: { language, personaKey, options: [4 x MarketingAngleOption], recommendedId }
  imageCandidatesJson Json? // cached image candidates for the wizard's Product Images step: { primary: ImageCandidate[], other: ImageCandidate[] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?
}

model ShopifyStore {
  id                 String    @id @default(uuid())
  shopDomain         String    @unique // e.g. "example.myshopify.com"
  accessTokenCipher  String // AES-256-GCM encrypted OAuth access token (lib/shopify/crypto.ts)
  refreshTokenCipher String? // encrypted refresh token; null for a token exchanged before expiring tokens were required
  expiresAt          DateTime? // when accessTokenCipher expires; null means it's a legacy non-expiring token
  scopes             String // space-separated scopes granted at install, as returned by Shopify

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model Project {
  id                String  @id @default(uuid())
  name              String
  productId         String  @unique
  product           Product @relation(fields: [productId], references: [id])
  configurationJson Json
  language          String  @default("en") // target language for generated customer-facing store content (ISO 639-1)
  personaJson       Json? // selected customer persona: { type: "generated", id, name, description } | { type: "custom", text }
  marketingAngleJson Json? // selected marketing angle: { id, title, description, selectionType: "generated" | "ai" }
  selectedImagesJson Json? // selected product images from the wizard's Product Images step: { images: ImageCandidate[] } (max 5, order = gallery order, first = featured). Never overwrites Product.images.

  shopifyStoreId          String?
  shopifyStore            ShopifyStore? @relation(fields: [shopifyStoreId], references: [id])
  installedThemeShopifyId String? // Shopify theme GID, set after the first successful themeCreate; reused on later publishes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishRecords PublishRecord[]
}

model PublishRecord {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  shopifyThemeId String
  status         String // "pending" | "success" | "failed"
  errorMessage   String?

  createdAt DateTime @default(now())
}
