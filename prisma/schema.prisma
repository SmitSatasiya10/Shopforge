// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                    String   @id @default(uuid())
  sourceUrl             String
  sourcePlatform        String // "shopify" | "generic_html" | "sample"
  importSource          String   @default("shopify") // which Start-screen entry point: "shopify" | "supplier" | "competitor" | "sample"
  supplierPlatform      String? // detected supplier platform for importSource="supplier": "aliexpress" | "amazon" | "zendrop" | "teemdrop" | "etsy"
  importStatus          String // pending | importing | succeeded | partial | failed
  importError           String?
  importedFieldsMissing String[] @default([])

  title           String?
  description     String?
  price           Decimal? @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  currency        String?
  vendor          String?
  images          Json     @default("[]")
  variants        Json     @default("[]")
  options         Json     @default("[]")
  rawData         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?
}

model Project {
  id                String  @id @default(uuid())
  name              String
  productId         String  @unique
  product           Product @relation(fields: [productId], references: [id])
  configurationJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
