// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An account that can sign in to the builder app and own Stores. Email/password only for now —
/// see docs/product-spec/21-security-and-multi-tenancy.md §2 for the future authProvider/OAuth
/// (google/shopify) shape and the Organization/role model layered on top of this later.
model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
}

model Product {
  id                    String   @id @default(uuid())
  sourceUrl             String
  sourcePlatform        String // "shopify" | "generic_html" | "sample" | "search_exact" | "search_related"
  importSource          String   @default("shopify") // which Start-screen entry point: "shopify" | "supplier" | "competitor" | "sample"
  supplierPlatform      String? // detected supplier platform for importSource="supplier": "amazon" | "etsy"
  importStatus          String // pending | importing | succeeded | partial | failed
  importError           String?
  importedFieldsMissing String[] @default([])

  title           String?
  description     String?
  price           Decimal? @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  currency        String?
  vendor          String?
  images          Json     @default("[]")
  variants        Json     @default("[]")
  options         Json     @default("[]")
  rawData         Json?
  personaOptionsJson Json? // cached AI persona options for the wizard: { language, options: [4 x PersonaOption] }
  marketingAnglesJson Json? // cached AI marketing angles: { language, personaKey, options: [4 x MarketingAngleOption], recommendedId }
  imageCandidatesJson Json? // cached image candidates for the wizard's Product Images step: { primary: ImageCandidate[], other: ImageCandidate[] }
  generatedImagesJson Json     @default("[]") // append-only log of editor "Edit with AI" results: GeneratedImage[] (lib/product/generated-images.ts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store?
}

model ShopifyStore {
  id                 String    @id @default(uuid())
  shopDomain         String    @unique // e.g. "example.myshopify.com"
  accessTokenCipher  String // AES-256-GCM encrypted OAuth access token (lib/shopify/crypto.ts)
  refreshTokenCipher String? // encrypted refresh token; null for a token exchanged before expiring tokens were required
  expiresAt          DateTime? // when accessTokenCipher expires; null means it's a legacy non-expiring token
  scopes             String // space-separated scopes granted at install, as returned by Shopify

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores         Store[]
  uploadedAssets ShopifyUploadedAsset[]
}

/// A merchant's store: owns the shared Product and (once connected) the shared Shopify OAuth
/// connection. A store has one or more Themes (Project rows) — independent storefront
/// configurations — of which at most one is the store's currently-live/active theme.
model Store {
  id   String @id @default(uuid())
  name String

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shopifyStoreId String?
  shopifyStore   ShopifyStore? @relation(fields: [shopifyStoreId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // The theme currently live on this store's connected Shopify shop (or, pre-connection, the
  // implicit "main" theme). Null only for the brief window before a store's first theme exists.
  activeThemeId String?  @unique
  activeTheme   Project? @relation("StoreActiveTheme", fields: [activeThemeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  themes Project[] @relation("StoreThemes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Caches "this setting value was already uploaded to this shop as Shopify file X" (lib/shopify/asset-upload.ts)
/// so a repeat publish doesn't re-upload the same image/video every time.
model ShopifyUploadedAsset {
  id               String   @id @default(uuid())
  shopifyStoreId   String
  shopifyStore     ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  sourceUrlHash    String // sha256 of the raw setting value -- data: URIs can be multi-MB, too large to index directly
  shopifyReference String // e.g. "shopify://shop_images/<filename>"
  createdAt        DateTime @default(now())

  @@unique([shopifyStoreId, sourceUrlHash])
}

// A theme: one independent storefront configuration belonging to a Store. Kept as the `Project`
// model/table name so `projectId` stays the identifier everywhere (editor route, checkpoints,
// publish records) — a "theme" and a "project" are the same thing from here on.
model Project {
  id                String @id @default(uuid())
  name              String // theme name, e.g. "Default", "Summer Sale" (not the store name)

  storeId String
  store   Store  @relation("StoreThemes", fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  configurationJson Json
  language          String  @default("en") // target language for generated customer-facing store content (ISO 639-1)
  personaJson       Json? // selected customer persona: { type: "generated", id, name, description } | { type: "custom", text }
  marketingAngleJson Json? // selected marketing angle: { id, title, description, selectionType: "generated" | "ai" }
  selectedImagesJson Json? // selected product images from the wizard's Product Images step: { images: ImageCandidate[] } (max 5, order = gallery order, first = featured). Never overwrites Product.images.

  // Public, unauthenticated storefront preview link (/preview/<publicPreviewToken>). Token is
  // generated on first enable and expires publicPreviewExpiresAt after that (see
  // PUBLIC_PREVIEW_LINK_TTL_DAYS) — re-enabling before expiry restores the same URL; re-enabling
  // (or rotating) after expiry mints a fresh token/expiry. Disabling just flips the flag; the
  // theme, its configuration, and the token are untouched.
  publicPreviewEnabled   Boolean   @default(false)
  publicPreviewToken     String?   @unique
  publicPreviewExpiresAt DateTime?

  versions ProjectVersion[]

  installedThemeShopifyId String? // Shopify theme GID, set after the first successful themeCreate; reused on later publishes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishRecords PublishRecord[]
  activeForStore Store?          @relation("StoreActiveTheme")
}

model PublishRecord {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shopifyThemeId String
  status         String // "pending" | "success" | "failed"
  errorMessage   String?

  createdAt DateTime @default(now())
}

// A checkpoint of the editor's "recent changes" history — a whole-state snapshot, batched by
// edit activity (see lib/history/checkpoint.ts), not a field-level diff. Shown in the editor's
// history panel and used to restore the project to an earlier point in time.
model ProjectVersion {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configurationJson Json
  productTitle      String?
  editCount         Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, updatedAt])
}
